{
  // バックアップAPI（段階6a）のデプロイ設定。
  //
  // このリポジトリには設定ファイルが3つある。取り違えないこと。
  //   ルート  wrangler.jsonc … アプリ本体（app.quiz-make.com）
  //   site/   wrangler.jsonc … ホームページ（quiz-make.com）
  //   api/    wrangler.jsonc … これ（api.quiz-make.com）
  //
  // Cloudflare 側の「Root directory」を api にして、このファイルを使わせる。
  //
  // 秘密の値は wrangler secret put で入れる（このファイルには書かない）:
  //   RESEND_API_KEY … メール送信の鍵
  //   SECRET_PEPPER  … ハッシュに混ぜる文字列。変えると全員がログアウトされる
  "name": "quizmake-api",
  "main": "src/index.js",
  "compatibility_date": "2026-08-18",

  // 受け口の住所。アプリ（app.quiz-make.com）はここへ呼びに行く。
  // custom_domain を付けると、デプロイ時に DNS レコードも自動で作られる。
  "routes": [{ "pattern": "api.quiz-make.com", "custom_domain": true }],

  "vars": {
    // 送信元。Resend で認証したドメインのアドレスにする
    "MAIL_FROM": "quizmake <no-reply@quiz-make.com>"
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "quizmake",
      // 2026-08-24 に `wrangler d1 create quizmake` で作ったもの
      "database_id": "42bc3945-97b7-4b37-b1be-59b01ab1181b"
    }
  ],

  "observability": {
    "enabled": true
  }
}
